{
  "name": "island-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "extension"
  ],
  "scripts": {
    "build:bytune-backend": "esbuild bytune-backend/server.ts --bundle --platform=node --format=cjs --outfile=dist-bytune/server.cjs --packages=external --alias:electron=./bytune-backend/electron-shim.ts",
    "dev": "npm run build:bytune-backend && concurrently -k \"node dist-bytune/server.cjs\" \"vite\"",
    "build": "npm run build:bytune-backend && tsc -b && vite build && npm run build --workspace=extension",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace=extension",
    "test": "vitest run",
    "tauri": "tauri",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@supabase/supabase-js": "^2.119.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "@types/jsdom": "^30.0.0",
    "bgutils-js": "^4.0.3",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.5",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.72.0",
    "motion": "^11.11.17",
    "music-metadata": "^11.16.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "youtubei.js": "^18.3.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.9.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
