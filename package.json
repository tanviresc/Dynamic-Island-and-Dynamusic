{
  "name": "island-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "extension"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build --workspace=extension",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace=extension",
    "test": "vitest run",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.72.0",
    "motion": "^11.11.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
