{
  "island-notifier": {
    "Stop": [
      {
        "type": "command",
        "command": "powershell -ExecutionPolicy Bypass -File \"./tools/island-hook.ps1\""
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File \"./tools/island-hook.ps1\""
          }
        ]
      }
    ]
  }
}
